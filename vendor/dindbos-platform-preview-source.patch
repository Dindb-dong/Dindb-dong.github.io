+  :scope .dos-windows-taskbar .dos-dock[data-liquid-glass-mode],
+  :scope[data-appearance="dark"] .dos-windows-taskbar .dos-dock[data-liquid-glass-mode] {
+    --dock-background: transparent; --dock-border: 0; --dock-shadow: none;
+    background: transparent; border: 0; box-shadow: none;
+    backdrop-filter: none !important; -webkit-backdrop-filter: none !important;
+  }
+  .dos-windows-taskbar .dos-dock-item { --dock-proximity: 0 !important; flex: 0 0 40px; width: 40px; min-width: 40px; height: 40px; padding: 6px; border-radius: 4px; transition: background 130ms; }
+  .dos-windows-taskbar .dos-dock-item:hover, .dos-windows-taskbar .dos-dock-item.is-active { background: var(--accent-soft); }
+  .dos-windows-taskbar .dos-dock-item.is-running .dos-dock-glyph::after { bottom: -4px; width: 6px; height: 3px; border-radius: 2px; background: var(--muted); }
+  .dos-windows-taskbar .dos-dock-item.is-active .dos-dock-glyph::after { width: 16px; background: var(--accent); }
