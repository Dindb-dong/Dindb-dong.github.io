+}
diff --git a/src/styles/platform-ios.css b/src/styles/platform-ios.css
new file mode 100644
index 0000000..869a790
--- /dev/null
+++ b/src/styles/platform-ios.css
@@ -0,0 +1,84 @@
+@scope (.dindbos-host[data-ui-style='ios']) to (.dindbos-host) {
+  :scope {
+    --ios-top: calc(52px + env(safe-area-inset-top, 0px));
+    --ios-bottom: calc(44px + env(safe-area-inset-bottom, 0px));
+    --font-ui: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  }
+  :scope .dos-menubar {
+    height: var(--ios-top); min-height: 52px; padding: env(safe-area-inset-top, 0px) 12px 0;
+    border: 0; background: var(--chrome-bg); box-shadow: none;
+  }
+  :scope .dos-menubar button { min-width: 44px; min-height: 44px; border-radius: 22px; }
+  :scope .dos-app-menus { min-width: 0; gap: 0; }
+  :scope .dos-menu-label { display: none; }
+  :scope .dos-active-app { max-width: 100px; overflow: hidden; text-overflow: ellipsis; }
+  :scope .dos-clock-date { display: none; }
+  :scope .dos-clock { font-size: 13px; font-weight: 600; }
+  :scope .dos-menu-status { gap: 0; }
+  :scope .dos-desktop {
+    inset: calc(var(--ios-top) + 16px) 12px calc(var(--ios-bottom) + 152px);
+    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: none;
+    grid-auto-flow: row; grid-auto-columns: auto; grid-auto-rows: 100px;
+    gap: 16px 4px; direction: ltr; align-content: start;
+  }
+  :scope .dos-icon { width: 100%; height: 100px; grid-template-rows: 60px auto; padding: 0; }
+  :scope .dos-icon-art, :scope .dos-icon-art svg, :scope .dos-icon-art img { width: 60px; height: 60px; }
+  :scope .dos-icon-label { max-width: 100%; font-size: 12px; line-height: 16px; }
+  :scope .dos-dock {
+    inset: auto 12px calc(var(--ios-bottom) + 8px); transform: none; width: auto; max-width: none;
+    height: 88px; padding: 12px; gap: 16px; align-items: center; border-radius: 28px;
+    overflow: auto hidden; overscroll-behavior: contain; scrollbar-width: thin;
+  }
+  :scope .dos-dock-item { flex: 0 0 56px; width: 56px; height: 56px; min-width: 56px; }
+  :scope .dos-dock-separator { flex-shrink: 0; }
+  :scope .dos-dock-tooltip { display: none; }
+  :scope .dos-ios-search {
+    position: absolute; bottom: calc(var(--ios-bottom) + 108px); left: 50%; transform: translateX(-50%);
+    z-index: 75; min-width: 88px; min-height: 44px; padding: 8px 20px; border: 1px solid var(--line);
+    border-radius: 24px; background: var(--chrome-bg); color: var(--text); font: inherit;
+    backdrop-filter: blur(20px);
+  }
+  :scope .dos-ios-home {
+    position: absolute; z-index: 1100; left: 50%; bottom: env(safe-area-inset-bottom, 0px);
+    transform: translateX(-50%); width: 160px; min-height: 44px; padding: 0;
+    display: grid; place-items: center; border: 0; border-radius: 22px;
+    background: transparent; color: var(--text); box-shadow: none;
+  }
+  :scope .dos-ios-home span { width: 128px; height: 5px; border-radius: 3px; background: currentColor; }
+  :scope .dos-ios-home:hover, :scope .dos-ios-search:hover { background: var(--control-hover); }
+  :scope .dos-ios-home:active, :scope .dos-ios-search:active { background: var(--control-pressed); }
+  :scope .dos-ios-home:focus-visible, :scope .dos-ios-search:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+  :scope .dos-window, :scope .dos-window:not(.is-maximized), :scope .dos-window.is-maximized {
+    inset: var(--ios-top) 0 var(--ios-bottom) !important; width: auto !important; height: auto !important;
+    max-width: none; min-width: 0; min-height: 0; border-radius: 0; border: 0;
+    grid-template-rows: 44px minmax(0, 1fr);
+  }
+  :scope .dos-window:not(.is-active):not(.is-minimizing) { visibility: hidden; pointer-events: none; }
+  :scope .dos-window-titlebar, :scope .dos-window[data-window-chrome] > .dos-window-titlebar {
+    position: static; width: auto; height: 44px; min-height: 44px; padding: 0 12px;
+    display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; background: var(--chrome-bg);
+  }
+  :scope .dos-window[data-window-chrome] > .dos-window-titlebar > strong { display: block; }
+  :scope .dos-window[data-window-chrome] > .dos-window-content { grid-row: 2; }
+  :scope .dos-window-controls { width: 44px; }
+  :scope .dos-window-controls button[data-window-close] {
+    width: 44px; height: 44px; border: 0; border-radius: 12px; background: transparent; color: var(--text);
+  }
+  :scope .dos-window-controls button[data-window-close] span { opacity: 1; font-size: 22px; }
+  :scope [data-window-minimize], :scope [data-window-maximize], :scope .dos-resize { display: none; }
+  :scope .dos-window-titlebar-spacer { width: 44px; }
+  :scope .dos-shell:has(.dos-window.is-active:not([hidden])) > :is(.dos-desktop, .dos-dock, .dos-ios-search) { visibility: hidden; pointer-events: none; }
+  :scope .dos-launcher { top: calc(var(--ios-top) + 8px); max-height: calc(100% - var(--ios-top) - var(--ios-bottom) - 16px); }
+  :scope .dos-launcher-search input { font-size: 16px; }
+  :scope .dos-launcher-results { max-height: min(420px, 48cqh); }
+  :scope .dos-launcher-results button, :scope .dos-shell-menu button { min-height: 44px; }
+  :scope .dos-shell-panel, :scope .dos-shell-menu { top: calc(var(--ios-top) + 8px); max-height: calc(100% - var(--ios-top) - var(--ios-bottom) - 16px); overflow-y: auto; }
+  @container (max-width: 350px) {
+    :scope .dos-active-app { max-width: 64px; }
+    :scope .dos-menubar { padding-inline: 4px; }
+    :scope .dos-icon-art, :scope .dos-icon-art svg, :scope .dos-icon-art img { width: 52px; height: 52px; }
+  }
+  @media (prefers-reduced-motion: reduce) {
+    :scope .dos-window, :scope .dos-dock-item { animation: none; transition: none; }
+  }
+}
diff --git a/src/styles/platform-windows-apps.css b/src/styles/platform-windows-apps.css
new file mode 100644
index 0000000..3c8f267
--- /dev/null
+++ b/src/styles/platform-windows-apps.css
@@ -0,0 +1,272 @@
+@scope (.dindbos-host[data-ui-style="windows"]) to (.dindbos-host) {
+  :scope { --win-page: #f3f3f3; --win-panel: #fff; --win-panel-hover: #f9f9f9; --win-border: #00000016; --win-text: #1b1b1b; --win-muted: #626262; }
+  :scope[data-appearance="dark"] { --win-page: #202020; --win-panel: #2b2b2b; --win-panel-hover: #323232; --win-border: #ffffff16; --win-text: #f3f3f3; --win-muted: #b9b9b9; }
+  :scope .dos-window { --chrome-bg: var(--windows-chrome); }
+  :scope .dos-window[data-app-id][data-window-chrome] > .dos-window-titlebar { width: 100%; min-width: 0; box-sizing: border-box; }
+  :scope :is(.files-app, .settings-app, .applications-app, .browser-app, .text-app, .viewer-app, .productivity-app, .media-app, .clock-app, .activity-app, .calculator-app, .portfolio-app) {
+    --content-bg: var(--win-panel); --sidebar-bg: var(--win-page); --chrome-bg: var(--win-page); --text: var(--win-text); --muted: var(--win-muted); --line: var(--win-border); --control-bg: var(--win-panel); --control-hover: var(--win-panel-hover);
+    font-family: var(--font-ui); color: var(--text); background: var(--content-bg);
+  }
+  :scope :is(.files-app, .settings-app, .applications-app, .browser-app, .text-app, .viewer-app, .productivity-app, .media-app, .clock-app, .activity-app, .calculator-app, .portfolio-app) :is(button, input, select, textarea) { font-family: var(--font-ui); }
+  :scope :is(.files-app, .settings-app, .applications-app, .browser-app, .text-app, .viewer-app, .productivity-app, .media-app, .clock-app, .activity-app, .calculator-app, .portfolio-app) button { border-radius: 4px; }
+  :scope :is(.files-app, .settings-app, .applications-app, .browser-app, .text-app, .viewer-app, .productivity-app, .media-app, .clock-app, .activity-app, .calculator-app, .portfolio-app) :is(button, input, select, textarea, summary):focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
+
+  /* File Explorer keeps its existing command, tab and context-menu actions. */
+  :scope .files-app { --files-content-bg: var(--win-panel); --files-sidebar-bg: var(--win-page); --files-control-bg: var(--win-panel); --files-control-hover: var(--win-panel-hover); --files-text: var(--win-text); --files-muted: var(--win-muted); --files-line: var(--win-border); grid-template-columns: 190px minmax(0, 1fr); }
+  :scope .files-app.has-inspector { grid-template-columns: 190px minmax(0, 1fr) 210px; }
+  :scope .files-app .files-sidebar { padding: 14px 8px; }
+  :scope .files-app .files-sidebar button { position: relative; min-height: 36px; border-radius: 4px; font-size: 13px; }
+  :scope .files-sidebar button.is-active { background: color-mix(in srgb, var(--text) 7%, transparent); color: var(--text); }
+  :scope .files-sidebar button.is-active::before { content: ""; position: absolute; left: 0; width: 3px; height: 16px; border-radius: 2px; background: var(--accent); }
+  :scope .files-app .files-commandbar { min-height: 52px; padding: 8px 12px; background: var(--win-page); }
+  :scope .files-app .files-commandbar > button, :scope .files-app .files-commandbar .files-history button, :scope .files-app .files-commandbar summary { height: 32px; min-height: 32px; border-radius: 4px; }
+  :scope .files-app .files-commandbar .files-search-field { height: 32px; border-radius: 4px; border-bottom-color: var(--muted); }
+  :scope .files-app .files-row { min-height: 34px; border-radius: 4px; }
+  :scope .files-app .files-row:nth-child(even) { background: transparent; }
+  :scope .files-app .files-row:hover:not(.is-selected) { background: var(--win-panel-hover); }
+  :scope .files-app .files-row.is-selected { background: var(--accent-soft); color: var(--text); }
+  :scope .files-app .files-row.is-selected > small { color: var(--muted); }
+  :scope :is(.files-action-menu, .files-context-menu, .files-rename-error) { border-radius: 8px; background: var(--win-panel); }
+  :scope .files-app :is(.files-history, .files-tools-group, .files-tabs) { border-radius: 4px; box-shadow: none; background: var(--win-panel); }
+  :scope .files-app .files-tools-group :is(button, summary), :scope .files-app .files-tab { border-radius: 4px; }
+  :scope .files-app .files-tab-item, :scope .files-app .files-tab-item button { border-radius: 4px 4px 0 0; }
+  :scope .files-app .files-tabstrip { background: var(--win-page); }
+  :scope .files-app .files-tabs { padding: 0; background: var(--win-page); }
+  :scope .files-app .files-tab-item.is-current { flex: 0 1 220px; background: var(--win-panel); box-shadow: none; }
+  :scope .files-app .files-tab-item .files-tab-close { left: auto; right: 3px; }
+  :scope .files-app .files-folder-art { filter: none; }
+  :scope .files-app .files-folder-art path:nth-child(1) { fill: #e5a000; }
+  :scope .files-app .files-folder-art path:nth-child(2) { fill: #ffe08a; }
+  :scope .files-app .files-folder-art path:nth-child(3) { fill: #ffcf40; }
+  :scope .files-app .files-folder-art path:nth-child(4) { stroke: #fff0b3; }
+  :scope .files-app .files-sidebar button svg { color: var(--win-muted); }
+  :scope .files-app .files-status { min-height: 28px; background: var(--win-page); }
+
+  /* Windows Settings: persistent categories beside readable grouped preferences. */
+  :scope .settings-app:has(.settings-sidebar) { grid-template-columns: 220px minmax(0, 1fr); background: var(--win-page); }
+  :scope .settings-app .settings-sidebar { padding: 16px 12px; background: var(--win-page); border-right: 0; }
+  :scope .settings-profile { padding: 4px 0 16px; margin-bottom: 12px; background: transparent; border: 0; box-shadow: none; }
+  :scope .settings-search { min-height: 32px; height: 32px; border-radius: 4px; background: var(--win-panel); border-bottom-color: var(--muted); box-shadow: none; }
+  :scope .settings-nav { gap: 4px; }
+  :scope .settings-nav-item { position: relative; min-height: 36px; border-radius: 4px; }
+  :scope .settings-nav-item.is-active { color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); box-shadow: none; }
+  :scope .settings-app .settings-nav-item.is-active :is(strong, small) { color: var(--win-text); }
+  :scope[data-appearance="dark"] .settings-app .settings-nav-item.is-active { background: color-mix(in srgb, var(--win-text) 7%, transparent); color: var(--win-text); }
+  :scope .settings-nav-item.is-active::before { content: ""; position: absolute; left: 0; width: 3px; height: 16px; border-radius: 2px; background: var(--accent); }
+  :scope .settings-nav-icon { background: transparent; color: var(--accent); box-shadow: none; border-radius: 0; }
+  :scope .settings-detail { padding: 0 24px 24px; background: var(--win-page); }
+  :scope .settings-detail-header { height: 64px; min-height: 64px; margin: 0 0 16px; background: var(--win-page); border: 0; }
+  :scope .settings-detail-header h2 { font-size: 28px; font-weight: 600; }
+  :scope .settings-history { border-radius: 4px; border: 0; box-shadow: none; background: transparent; }
+  :scope .settings-history button { border-radius: 4px; }
+  :scope .settings-detail :is(.appearance-setting-row, .settings-preference-group, .settings-wallpaper-summary, .settings-panel) { padding: 16px; background: var(--win-panel); border: 1px solid var(--line); border-radius: 4px; }
+  :scope .settings-detail .appearance-mode-preview { border-radius: 4px; }
+
+  /* Browser uses a tab strip above a left-aligned address and command row. */
+  :scope .browser-app, :scope .browser-app:has(.browser-tabs[data-single-tab="true"]) { grid-template-rows: 38px 48px minmax(0, 1fr); }
+  :scope .browser-app .browser-tabs, :scope .browser-app .browser-tabs[data-single-tab="true"] { grid-row: 1; height: 38px; min-height: 38px; padding: 5px 10px 0; gap: 5px; background: var(--win-page); }
+  :scope .browser-app .browser-tabs[data-single-tab="true"] .browser-tab-list { display: flex; }
+  :scope .browser-app .browser-tabs[data-single-tab="true"] .browser-tab-actions { position: static; }
+  :scope .browser-app .browser-toolbar { grid-row: 2; padding: 8px 12px; height: 48px; background: var(--win-panel); border-bottom: 1px solid var(--line); }
+  :scope .browser-app .browser-viewport { grid-row: 3; }
+  :scope .browser-app .browser-tab-item { border-radius: 6px 6px 0 0; height: 32px; }
+  :scope .browser-app .browser-tab-item [role="tab"] { height: 32px; padding: 0 32px 0 12px; justify-content: flex-start; font: 12px var(--font-ui); border-radius: 6px 6px 0 0; }
+  :scope .browser-app .browser-tabs .browser-tab-close { left: auto; right: 5px; top: 6px; opacity: 1; }
+  :scope .browser-app .browser-tab-item.is-active { background: var(--win-panel); box-shadow: none; }
+  :scope .browser-app .browser-address-field { width: 100%; max-width: none; border-radius: 4px; height: 32px; background: var(--win-page); box-shadow: none; }
+  :scope .browser-app .browser-toolbar .browser-address-field input { text-align: left; font: 13px var(--font-ui); }
+  :scope .browser-app .browser-navigation-controls button { width: 32px; height: 32px; border-radius: 4px; }
+  :scope .browser-app .browser-connection-panel { border-radius: 8px; }
+
+  /* Installed applications retain search/categories, arranged as a Windows app catalog. */
+  :scope .applications-app { background: var(--win-panel); }
+  :scope .applications-app .applications-header { height: 60px; padding: 12px 24px; background: var(--win-page); }
+  :scope .applications-title h1 { font-size: 24px; font-weight: 600; letter-spacing: 0; }
+  :scope .applications-app .applications-search { border-radius: 4px; height: 32px; }
+  :scope .applications-app .applications-search { flex: 1; padding: 0 10px; border: 1px solid var(--line); border-bottom-color: var(--muted); background: var(--win-panel); }
+  :scope .applications-app .applications-search input { height: 30px; font-size: 14px; letter-spacing: 0; }
+  :scope .applications-search > svg { width: 18px; height: 18px; flex-basis: 18px; }
+  :scope .applications-categories { padding: 10px 24px; background: var(--win-page); gap: 8px; }
+  :scope .applications-categories button { border-radius: 4px; }
+  :scope .applications-library { padding: 24px; }
+  :scope .applications-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
+  :scope .applications-grid .applications-item { flex-direction: row; align-items: center; min-height: 68px; gap: 12px; padding: 10px; border-radius: 4px; }
+  :scope .applications-icon { width: 40px; height: 40px; flex-basis: 40px; filter: none; }
+  :scope .applications-item-name { text-align: left; font-size: 13px; }
+
+  /* Notes: compact notebook list and a paper-like document pane. */
+  :scope .notes-app { grid-template-columns: 160px 220px minmax(0, 1fr); background: var(--win-panel); }
+  :scope .notes-folders { padding: 16px 10px; }
+  :scope .notes-folder-selected { border-radius: 4px; border-left: 3px solid #7b3fa0; background: color-mix(in srgb, #7b3fa0 12%, var(--win-page)); }
