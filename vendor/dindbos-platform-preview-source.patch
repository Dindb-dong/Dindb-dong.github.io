+    :scope .note-editor > input[data-note-title], :scope .note-editor > textarea { padding-inline: 12px; }
+    :scope .reminders-app { display: flex; flex-direction: column; }
+    :scope .reminders-app .productivity-sidebar { padding: 8px; }
+    :scope .reminder-smart-lists { flex-direction: row; overflow-x: auto; }
