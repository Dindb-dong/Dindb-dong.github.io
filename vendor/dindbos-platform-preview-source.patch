+  .dos-window, .dos-window[data-window-chrome="document"], .dos-window[data-window-chrome="integrated"] { grid-template-rows: 40px minmax(0, 1fr); border-radius: 8px; backdrop-filter: none; }
+  .dos-window > .dos-window-titlebar, .dos-window[data-window-chrome="integrated"] > .dos-window-titlebar, .dos-window[data-window-chrome="document"] > .dos-window-titlebar { position: static; display: grid; grid-template-columns: minmax(0, 1fr) 138px; width: auto; height: 40px; min-height: 40px; padding: 0 0 0 16px; gap: 8px; background: var(--windows-chrome); border-bottom: 1px solid var(--line); }
+  :scope .dos-window > .dos-window-titlebar { background: var(--windows-chrome) !important; box-shadow: none; backdrop-filter: none !important; }
