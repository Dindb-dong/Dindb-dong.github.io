+  const root = page.locator('#dindbos-root .dindbos-host');
+  for (const [device, desktop, mobile] of [['macos', 'windows', 'android'], ['windows', 'macos', 'ios'], ['ios', 'windows', 'android'], ['android', 'macos', 'ios'], ['other', 'macos', 'macos']]) {
