+  :scope .activity-bottom-summary { display: flex; flex-wrap: wrap; gap: 12px; font-size: 13px; padding: 16px 0; }
+  :scope .portfolio-app { padding: 28px 20px; background: var(--ios-grouped); min-height: 100%; }
