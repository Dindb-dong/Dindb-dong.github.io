+
+  /* Clock: daylight map retained, cities become stacked reachable groups. */
+  :scope .clock-app { --clock-accent: var(--oneui-blue); --text: var(--oneui-ink); --muted: var(--oneui-secondary); --line: var(--oneui-line); --control-bg: var(--oneui-page); --sidebar-bg: var(--oneui-page); display: flex; flex-direction: column; color: var(--oneui-ink); background: var(--oneui-page); }
