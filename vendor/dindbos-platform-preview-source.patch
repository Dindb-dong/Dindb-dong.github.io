+  :scope .notes-sidebar header strong { display: block; font-size: 12px; }
+  :scope .notes-editor-toolbar { height: 48px; flex-basis: 48px; padding: 8px 12px; background: var(--win-page); }
+  :scope .notes-list button { margin-bottom: 6px; min-height: 70px; padding: 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--win-panel); }
+  :scope .notes-list button[aria-pressed="true"] { border-left: 3px solid #7b3fa0; background: var(--win-panel); }
+  :scope .note-editor > input[data-note-title] { padding: 10px 24px; font-size: 26px; font-weight: 600; }
+  :scope .note-editor > textarea { padding: 8px 24px 24px; font-size: 14px; line-height: 1.65; }
+  :scope .note-toolbar { text-align: left; padding-inline: 24px; }
+
+  /* To Do grammar: quiet task navigation, a heading and distinct task rows. */
+  :scope .reminders-app { grid-template-columns: 210px minmax(0, 1fr); }
+  :scope .reminders-app .productivity-sidebar { padding: 18px 10px; }
+  :scope .reminder-smart-lists { display: flex; flex-direction: column; gap: 4px; }
+  :scope .reminder-smart-lists button { display: flex; align-items: center; min-height: 40px; gap: 10px; padding: 8px; background: transparent; border-radius: 4px; color: var(--text); }
+  :scope .reminder-smart-lists button svg { order: 0; color: var(--accent); background: transparent; padding: 1px; width: 20px; height: 20px; }
+  :scope .reminder-smart-lists button span { order: 1; font-weight: 400; }
