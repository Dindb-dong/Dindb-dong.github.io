+  .dos-searchable-select > svg { position: absolute; left: 12px; top: 13px; width: 18px; height: 18px; color: var(--dos-select-muted, var(--muted)); pointer-events: none; }
+  .dos-searchable-select > svg:last-of-type { left: auto; right: 12px; }
+  .dos-select-menu { box-sizing: border-box; position: fixed; inset: auto; margin: 0; padding: 6px; overflow: auto; overscroll-behavior: contain; border: 1px solid var(--dos-select-line, var(--line)); border-radius: 20px; background: var(--dos-select-bg, var(--content-bg)); color: var(--dos-select-text, var(--text)); box-shadow: var(--menu-shadow); font: 13px var(--font-ui, sans-serif); }
+  .dos-select-option { display: flex; align-items: center; width: 100%; min-height: 44px; padding: 9px 10px; border: 0; border-radius: 14px; background: transparent; color: inherit; cursor: pointer; font: inherit; text-align: left; }
