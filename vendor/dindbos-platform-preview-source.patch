+  :scope .reminder-smart-lists button[aria-pressed="true"] { background: var(--accent-soft); color: var(--text); }
+  :scope .reminder-main { background: var(--win-page); padding: 0 24px 24px; }
+  :scope .reminder-main h1, :scope .reminder-main > header > span { color: var(--text); font-size: 28px; }
+  :scope .reminder-create { padding: 12px; border-radius: 4px; border: 1px solid var(--line); background: var(--win-panel); }
+  :scope .reminder-list li { margin-top: 6px; padding: 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--win-panel); }
+
+  /* Calendar retains all month/agenda actions and event controls. */
