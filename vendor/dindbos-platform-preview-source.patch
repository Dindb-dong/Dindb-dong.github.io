+    :scope .calendar-app { grid-template-columns: minmax(0, 1fr); }
+    :scope .calendar-sidebar { padding: 10px; }
+    :scope .calendar-topbar { padding-left: 12px; }
+    :scope .applications-app .applications-header { padding: 10px 12px; }
+    :scope .applications-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
+    :scope .browser-app .browser-toolbar { padding: 8px; gap: 6px; }
+    :scope .clock-toolbar { padding-left: 8px; }
+    :scope .clock-toolbar button { padding-inline: 8px; }
