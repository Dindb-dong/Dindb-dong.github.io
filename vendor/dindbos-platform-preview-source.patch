+  :scope .music-player { position: absolute; inset: auto 0 0; width: auto; max-width: none; min-width: 0; transform: none; padding: 12px 20px; height: 104px; border: 0; border-top: 1px solid var(--line); border-radius: 0; background: var(--win-page); box-shadow: none; backdrop-filter: none; }
+  :scope .music-library { padding: 12px 20px 124px; }
